import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.IOException;
import java.io.InputStreamReader;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;

public class InventoryManager {
    private static final Path CSV_FILE = Path.of("data", "inventory.csv");
    private static final Path REPORT_FILE = Path.of("data", "inventory-report.txt");

    public static void main(String[] args) {
        // Không đóng reader gắn với System.in
        BufferedReader console = new BufferedReader(
                new InputStreamReader(System.in, StandardCharsets.UTF_8));

        // 1. Nhập từ bàn phím
        List<Product> input = nhapSanPham(console);

        // 2. Lưu vào CSV
        if (!input.isEmpty()) {
            luuCsv(input);
        }

        // 3. Đọc lại CSV, tái tạo đối tượng
        List<Product> products = docCsv(CSV_FILE);
        if (products.isEmpty()) {
            System.out.println("Không có sản phẩm nào để xử lý.");
            return;
        }

        // 4. Hiển thị và tính tổng
        double total = 0;
        System.out.println("\n=== DANH SÁCH SẢN PHẨM ===");
        for (Product p : products) {
            System.out.println(p);
            total += p.inventoryValue();
        }
        System.out.printf("Tổng giá trị tồn kho: %,.0f VND%n", total);

        // 5. Sản phẩm có giá trị tồn kho cao nhất
        Product max = products.get(0);
        for (Product p : products) {
            if (p.inventoryValue() > max.inventoryValue()) {
                max = p;
            }
        }
        System.out.println("Giá trị cao nhất: " + max);

        // 6. Ghi báo cáo
        ghiBaoCao(products, total, max);
    }

    // ---------- Nhập liệu ----------
    private static List<Product> nhapSanPham(BufferedReader console) {
        List<Product> list = new ArrayList<>();
        try {
            System.out.print("Nhập số lượng sản phẩm cần nhập (0 để dùng file có sẵn): ");
            String s = console.readLine();
            if (s == null) return list;
            int n;
            try {
                n = Integer.parseInt(s.trim());
            } catch (NumberFormatException e) {
                System.err.println("Số lượng sản phẩm không hợp lệ: \"" + s + "\"");
                return list;
            }

            int i = 1;
            while (i <= n) {
                System.out.println("--- Sản phẩm " + i + " ---");
                System.out.print("Mã: ");
                String code = console.readLine();
                System.out.print("Tên: ");
                String name = console.readLine();
                System.out.print("Đơn giá: ");
                String priceStr = console.readLine();
                System.out.print("Số lượng: ");
                String qtyStr = console.readLine();

                if (code == null || name == null || priceStr == null || qtyStr == null) {
                    System.err.println("Gặp EOF, dừng nhập.");
                    break;
                }
                try {
                    Product p = new Product(code, name,
                            Double.parseDouble(priceStr.trim()),
                            Integer.parseInt(qtyStr.trim()));
                    list.add(p);
                    i++;
                } catch (IllegalArgumentException e) {
                    // gồm cả NumberFormatException
                    System.err.println("Từ chối sản phẩm " + i + ": " + e.getMessage()
                            + ". Vui lòng nhập lại.");
                }
            }
        } catch (IOException e) {
            System.err.println("Không đọc được dữ liệu từ bàn phím: " + e.getMessage());
        }
        return list;
    }

    // ---------- Ghi CSV ----------
    private static void luuCsv(List<Product> list) {
        try {
            Files.createDirectories(CSV_FILE.getParent());
            try (BufferedWriter writer = Files.newBufferedWriter(
                    CSV_FILE, StandardCharsets.UTF_8)) {
                writer.write("ma,ten,donGia,soLuong");
                writer.newLine();
                for (Product p : list) {
                    writer.write(p.toCsv());
                    writer.newLine();
                }
            }
            System.out.println("Đã lưu " + list.size() + " sản phẩm vào " + CSV_FILE);
        } catch (IOException e) {
            System.err.println("Không ghi được tệp " + CSV_FILE + ": " + e.getMessage());
        }
    }

    // ---------- Đọc CSV ----------
    private static List<Product> docCsv(Path file) {
        List<Product> list = new ArrayList<>();

        if (!Files.exists(file)) {
            System.err.println("Không tìm thấy tệp: " + file.toAbsolutePath());
            return list;
        }

        try (BufferedReader reader = Files.newBufferedReader(
                file, StandardCharsets.UTF_8)) {
            reader.readLine(); // bỏ dòng tiêu đề
            String line;
            int lineNumber = 1;

            while ((line = reader.readLine()) != null) {
                lineNumber++;
                if (line.isBlank()) continue;

                String[] parts = line.split(",", -1);
                if (parts.length != 4) {
                    System.err.println("Tệp " + file + ", dòng " + lineNumber
                            + ": thiếu/thừa cột (có " + parts.length + " cột), bỏ qua.");
                    continue;
                }
                try {
                    list.add(new Product(
                            parts[0].trim(), parts[1].trim(),
                            Double.parseDouble(parts[2].trim()),
                            Integer.parseInt(parts[3].trim())));
                } catch (IllegalArgumentException e) {
                    System.err.println("Tệp " + file + ", dòng " + lineNumber
                            + ": dữ liệu không hợp lệ (" + e.getMessage() + "), bỏ qua.");
                }
            }
        } catch (IOException e) {
            System.err.println("Không đọc được tệp " + file + ": " + e.getMessage());
        }
        return list;
    }

    // ---------- Ghi báo cáo ----------
    private static void ghiBaoCao(List<Product> list, double total, Product max) {
        try {
            Files.createDirectories(REPORT_FILE.getParent());
            try (BufferedWriter writer = Files.newBufferedWriter(
                    REPORT_FILE, StandardCharsets.UTF_8)) {
                writer.write("BÁO CÁO TỒN KHO");
                writer.newLine();
                writer.write("Số sản phẩm: " + list.size());
                writer.newLine();
                writer.write("Tổng giá trị tồn kho: %,.0f VND".formatted(total));
                writer.newLine();
                writer.write("Sản phẩm giá trị cao nhất: " + max.getCode() + " - "
                        + max.getName() + " (%,.0f VND)".formatted(max.inventoryValue()));
                writer.newLine();
            }
            System.out.println("Đã ghi báo cáo vào " + REPORT_FILE);
        } catch (IOException e) {
            System.err.println("Không ghi được tệp " + REPORT_FILE + ": " + e.getMessage());
        }
    }
}

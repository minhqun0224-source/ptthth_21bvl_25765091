package bai9;

import java.rmi.Naming;
import java.util.ArrayList;
import java.util.Scanner;

public class AuctionClient {
    public static void main(String[] args) {
        try {
            AuctionService service = (AuctionService) Naming.lookup("rmi://localhost:1099/AuctionService");
            Scanner sc = new Scanner(System.in);

            System.out.print("Nhap ten cua ban: ");
            String myName = sc.nextLine();

          
            AuctionListenerImpl listener = new AuctionListenerImpl();
            service.registerListener(listener);

            boolean running = true;
            while (running) {
                System.out.println();
                System.out.println("===== DAU GIA TRUC TUYEN (" + myName + ") =====");
                System.out.println("1. Dang san pham (Seller)");
                System.out.println("2. Xem danh sach san pham (Bidder)");
                System.out.println("3. Dat gia thau (Bidder)");
                System.out.println("0. Thoat");
                System.out.print("Chon: ");
                String choice = sc.nextLine();

                if (choice.equals("1")) {
                    System.out.print("Nhap ten san pham: ");
                    String name = sc.nextLine();
                    System.out.print("Nhap gia khoi diem: ");
                    double startPrice = Double.parseDouble(sc.nextLine());
                    if (service.addProduct(name, startPrice, myName)) {
                        System.out.println("Da dang san pham.");
                    } else {
                        System.out.println("That bai (ten bi trung hoac gia khong hop le).");
                    }
                } else if (choice.equals("2")) {
                    ArrayList<Product> list = service.getProducts();
                    if (list.size() == 0) {
                        System.out.println("Chua co san pham nao.");
                    }
                    for (int i = 0; i < list.size(); i++) {
                        System.out.println((i + 1) + ". " + list.get(i));
                    }
                } else if (choice.equals("3")) {
                    System.out.print("Nhap ten san pham: ");
                    String name = sc.nextLine();
                    System.out.print("Nhap gia thau: ");
                    double price = Double.parseDouble(sc.nextLine());
                    if (service.placeBid(name, myName, price)) {
                        System.out.println("Dat gia thau thanh cong.");
                    } else {
                        System.out.println("That bai (khong co san pham hoac gia khong cao hon gia hien tai).");
                    }
                } else if (choice.equals("0")) {
                    running = false;
                } else {
                    System.out.println("Lua chon khong hop le.");
                }
            }

           
            System.exit(0);
        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}



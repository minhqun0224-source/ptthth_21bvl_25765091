package bai8;

import java.rmi.Naming;
import java.util.Scanner;

public class FlightClient {
    public static void main(String[] args) {
        try {
            FlightService service = (FlightService) Naming.lookup("rmi://localhost:1099/FlightService");
            Scanner sc = new Scanner(System.in);

            boolean running = true;
            while (running) {
                System.out.println();
                System.out.println("===== DAT VE MAY BAY =====");
                System.out.println("(Chuyen bay co san: VN123, VJ456, QH789)");
                System.out.println("1. Dat ve");
                System.out.println("2. Xem so ghe trong");
                System.out.println("3. Huy ve");
                System.out.println("0. Thoat");
                System.out.print("Chon: ");
                String choice = sc.nextLine();

                if (choice.equals("1")) {
                    System.out.print("Nhap ma chuyen bay: ");
                    String flight = sc.nextLine().toUpperCase();
                    System.out.print("Nhap so ghe can dat: ");
                    int seats = Integer.parseInt(sc.nextLine());
                    if (service.bookTicket(flight, seats)) {
                        System.out.println("Dat ve thanh cong.");
                    } else {
                        System.out.println("Dat ve that bai (sai ma chuyen bay hoac khong du ghe).");
                    }
                } else if (choice.equals("2")) {
                    System.out.print("Nhap ma chuyen bay: ");
                    String flight = sc.nextLine().toUpperCase();
                    int available = service.availableSeats(flight);
                    if (available == -1) {
                        System.out.println("Khong co chuyen bay nay.");
                    } else {
                        System.out.println("So ghe con trong: " + available);
                    }
                } else if (choice.equals("3")) {
                    System.out.print("Nhap ma chuyen bay: ");
                    String flight = sc.nextLine().toUpperCase();
                    System.out.print("Nhap so ghe can huy: ");
                    int seats = Integer.parseInt(sc.nextLine());
                    if (service.cancelBooking(flight, seats)) {
                        System.out.println("Huy ve thanh cong.");
                    } else {
                        System.out.println("Huy ve that bai (sai ma chuyen bay hoac huy qua so ghe da dat).");
                    }
                } else if (choice.equals("0")) {
                    running = false;
                } else {
                    System.out.println("Lua chon khong hop le.");
                }
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}


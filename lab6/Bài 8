package bai8;

import java.rmi.Remote;
import java.rmi.RemoteException;

public interface FlightService extends Remote {
   
    boolean bookTicket(String flightNumber, int seats) throws RemoteException;

  
    int availableSeats(String flightNumber) throws RemoteException;


    boolean cancelBooking(String flightNumber, int seats) throws RemoteException;
}

package bai8;

import java.rmi.RemoteException;
import java.rmi.server.UnicastRemoteObject;
import java.util.HashMap;

public class FlightServiceImpl extends UnicastRemoteObject implements FlightService {

  
    private HashMap<String, Integer> availableMap = new HashMap<String, Integer>();


    private HashMap<String, Integer> bookedMap = new HashMap<String, Integer>();

    public FlightServiceImpl() throws RemoteException {
        super();
  
        availableMap.put("VN123", 100);
        availableMap.put("VJ456", 50);
        availableMap.put("QH789", 80);

        bookedMap.put("VN123", 0);
        bookedMap.put("VJ456", 0);
        bookedMap.put("QH789", 0);
    }

    public boolean bookTicket(String flightNumber, int seats) throws RemoteException {
   
        if (!availableMap.containsKey(flightNumber)) {
            return false;
        }
        int available = availableMap.get(flightNumber);
        int booked = bookedMap.get(flightNumber);

      
        if (seats <= 0 || seats > available) {
            return false;
        }
        availableMap.put(flightNumber, available - seats);
        bookedMap.put(flightNumber, booked + seats);
        return true;
    }

    public int availableSeats(String flightNumber) throws RemoteException {
        if (!availableMap.containsKey(flightNumber)) {
            return -1;
        }
        return availableMap.get(flightNumber);
    }

    public boolean cancelBooking(String flightNumber, int seats) throws RemoteException {
        if (!availableMap.containsKey(flightNumber)) {
            return false;
        }
        int available = availableMap.get(flightNumber);
        int booked = bookedMap.get(flightNumber);

      
        if (seats <= 0 || seats > booked) {
            return false;
        }
        availableMap.put(flightNumber, available + seats);
        bookedMap.put(flightNumber, booked - seats);
        return true;
    }
}
